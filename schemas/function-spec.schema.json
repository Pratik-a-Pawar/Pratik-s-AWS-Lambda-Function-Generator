{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "function-spec.schema.json",
  "title": "Lambda function spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "name",
    "purpose",
    "owner",
    "runtime",
    "architecture",
    "trigger",
    "permissions",
    "timeout",
    "memory",
    "failure_destination",
    "log_retention_days",
    "data_classification"
  ],
  "properties": {
    "spec_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$(?![\\s\\S])" },
    "purpose": { "type": "string", "minLength": 10, "maxLength": 500 },
    "owner": { "type": "string", "minLength": 1 },
    "runtime": { "enum": ["python3.13", "python3.14"] },
    "architecture": { "enum": ["arm64", "x86_64"] },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "expression"],
          "properties": {
            "type": { "const": "schedule" },
            "expression": { "type": "string" },
            "timezone": { "type": "string", "default": "UTC" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pattern"],
          "properties": {
            "type": { "const": "eventbridge" },
            "pattern": { "type": "object", "minProperties": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "bucket", "events"],
          "properties": {
            "type": { "const": "s3" },
            "bucket": { "type": "string" },
            "events": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "prefix": { "type": "string" },
            "suffix": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "queue_name"],
          "properties": {
            "type": { "const": "sqs" },
            "queue_name": { "type": "string" },
            "batch_size": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 10 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "method", "path", "auth"],
          "properties": {
            "type": { "const": "http" },
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "pattern": "^/\\S*$(?![\\s\\S])" },
            "auth": { "enum": ["iam", "jwt", "none"] }
          }
        }
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actions", "resources", "reason"],
        "properties": {
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9-]+:[A-Za-z0-9*]+$(?![\\s\\S])" }
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$(?![\\s\\S])" },
      "additionalProperties": { "type": "string" }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "reference"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$(?![\\s\\S])" },
          "source": { "enum": ["ssm", "secretsmanager"] },
          "reference": { "type": "string" }
        }
      }
    },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 900 },
    "memory": { "type": "integer", "minimum": 128, "maximum": 10240 },
    "reserved_concurrency": { "type": "integer", "minimum": 0 },
    "failure_destination": { "enum": ["sqs", "sns", "none"] },
    "log_retention_days": {
      "enum": [1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 3653]
    },
    "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "risk_acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "justification", "accepted_by", "expires"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^LFG-[A-Z]+-[0-9]{3}$(?![\\s\\S])" },
          "justification": { "type": "string", "minLength": 20 },
          "accepted_by": { "type": "string", "minLength": 1 },
          "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])" }
        }
      }
    }
  }
}
